# Copy this file to .env and fill in the values. Never commit .env.

# --- Gemini (server side) ---
# Required for every AI feature (document analysis, Q&A, market updates,
# catchment intelligence, live voice advisor). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Google Maps (browser) ---
# Browser key for the UK regional map. Restrict it to your site's domain.
VITE_GOOGLE_MAPS_API_KEY=""

# --- PostgreSQL (reports, snapshots, documents, email digests) ---
# Used by the app at runtime.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
# Used only by `npm run db:push` to create/update tables (needs DDL rights).
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# --- Email (optional) ---
# Needed only to actually send monthly valuation emails. Without it, digests
# are still generated, stored and previewable in the app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Market data (public explorer + quick valuation) ---
# Folder holding listings_all.csv (or uk_dental_listings_YYYY-MM.csv) and
# market_index.csv. Keep it OUT of git: the listings are copied from broker
# sites and are only ever served as aggregates. Without it, a synthetic sample is used.
MARKET_DATA_DIR="data/market"
