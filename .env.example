# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform browser key.
VITE_GOOGLE_MAPS_API_KEY=""

# Optional SMTP configuration for dispatching live monthly valuation emails.
# When omitted, monthly digests are generated, archived in Cloud SQL, and previewable in-app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
