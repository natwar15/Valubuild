# Copy this file to .env and fill in the values. Never commit .env.

# --- Gemini (server side) ---
# Required for every AI feature (document analysis, Q&A, market updates,
# catchment intelligence, live voice advisor). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Google Maps (browser) ---
# Browser key for the UK regional map. Restrict it to your site's domain.
VITE_GOOGLE_MAPS_API_KEY=""

# --- PostgreSQL (reports, snapshots, documents, email digests) ---
# Used by the app at runtime.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
# Used only by `npm run db:push` to create/update tables (needs DDL rights).
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
# TLS to Postgres: "true" (verify certificate), "no-verify" (Cloud SQL public IP),
# or leave empty for a local/private database. Needed when hosting on Netlify.
SQL_SSL=""

# --- Email ---
# Sends the 12-point checklist to people who join the founding-owner list, and
# the monthly valuation emails. Without it no email goes out (digests are still
# stored and previewable in the app). Any SMTP provider works, e.g. Google
# Workspace (smtp.gmail.com, app password), Resend, SendGrid or Postmark.
# SMTP_FROM must be an address that provider is allowed to send from.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Market data (public explorer + quick valuation) ---
# Folder holding listings_all.csv (or uk_dental_listings_YYYY-MM.csv) and
# market_index.csv. Keep it OUT of git: the listings are copied from broker
# sites and are only ever served as aggregates. Without it, a synthetic sample is used.
MARKET_DATA_DIR="data/market"
# Key for the encrypted copy bundled in src/server/generated (used when the
# folder above has no files, e.g. on Netlify). Base64, 32 bytes.
MARKET_DATA_KEY=""

# --- Firebase Admin (account deletion) ---
# Automatic on Google Cloud. Elsewhere (Netlify), the service account key JSON,
# base64-encoded. Without it, account deletion can't remove Firestore data.
FIREBASE_SERVICE_ACCOUNT=""

# --- Hosting ---
# PORT defaults to 3000. Set TRUST_PROXY=1 behind Cloud Run or a load balancer
# (not on Netlify) so rate limits use the visitor's IP.
PORT=""
TRUST_PROXY=""
